{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfday6lab"
		},
		"azsqldb_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'azsqldb_ls'"
		},
		"ip_ls_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ip_ls'"
		},
		"op_ls_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'op_ls'"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv700737.vault.azure.net/"
		},
		"azsqldb_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azsqldbsrvr700737.database.windows.net"
		},
		"azsqldb_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "azsqldb"
		},
		"azsqldb_ls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"srcconn2csv_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "secret700737"
		},
		"tgtconn2csv_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "secret700737"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfday6lab_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"azsqldb_ls_password": {
						"value": "[parameters('azsqldb_ls_password')]"
					},
					"ip_ls_connectionString": {
						"value": "[parameters('ip_ls_connectionString')]"
					},
					"op_ls_connectionString": {
						"value": "[parameters('op_ls_connectionString')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"azsqldb_ls_properties_typeProperties_server": {
						"value": "[parameters('azsqldb_ls_properties_typeProperties_server')]"
					},
					"azsqldb_ls_properties_typeProperties_database": {
						"value": "[parameters('azsqldb_ls_properties_typeProperties_database')]"
					},
					"azsqldb_ls_properties_typeProperties_userName": {
						"value": "[parameters('azsqldb_ls_properties_typeProperties_userName')]"
					},
					"srcconn2csv_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('srcconn2csv_properties_typeProperties_connectionString_secretName')]"
					},
					"tgtconn2csv_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('tgtconn2csv_properties_typeProperties_connectionString_secretName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}